generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  ANONYMIZED
}
enum ComplaintType {
  RECLAMO
  QUEJA
}
enum ComplaintStatus {
  RECEIVED
  IN_REVIEW
  RESPONDED
  CLOSED
}
enum SuggestionCategory {
  MEJORA
  NUEVA_FUNCION
  PROBLEMA_UX
  OTRO
}
enum SuggestionStatus {
  SUBMITTED
  REVIEWING
  PLANNED
  DECLINED
  COMPLETED
}
enum PlanCode {
  FREE
  PLUS
  PRO
}
enum LedgerType {
  MONTHLY_GRANT
  PURCHASE
  RESERVATION
  CONSUMPTION
  REFUND
  ADMIN_ADJUSTMENT
  ADMIN_TEST
}
enum UsageStatus {
  RESERVED
  COMPLETED
  FAILED
  CANCELLED
  ADMIN_TEST
}
enum PaymentOrderStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}
enum PaymentStatus {
  APPROVED
  REJECTED
}
enum HistoryStatus {
  COMPLETED
  FAILED
  CANCELLED
}
enum ProcessingType {
  LOCAL
  SERVER
  EXTERNAL
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  displayName  String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions Session[]
  plans UserPlan[]
  ledger CreditLedger[]
  usages ProcessingUsage[]
  orders PaymentOrder[]
  reviewedPayments Payment[] @relation("PaymentReviewer")
  auditActions AdminAuditLog[] @relation("AdminActions")
  auditTargets AdminAuditLog[] @relation("AuditTargets")
  history ProcessingHistory[]
  complaints Complaint[]
  suggestions Suggestion[]
}

model DeniedIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  emailHash String   @unique
  reason    String
  createdAt DateTime @default(now())
  adminId   String   @db.Uuid
  @@index([createdAt])
}

model Complaint {
  id           String          @id @default(uuid()) @db.Uuid
  trackingCode String          @unique
  userId       String?         @db.Uuid
  claimantName String
  email        String
  type         ComplaintType
  subject      String
  detail       String
  status       ComplaintStatus @default(RECEIVED)
  flagged      Boolean         @default(false)
  adminResponse String?
  respondedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Suggestion {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  category      SuggestionCategory
  title         String
  description   String
  status        SuggestionStatus   @default(SUBMITTED)
  adminResponse String?
  reaction      String?
  respondedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ProcessingHistory {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  toolId         String
  status         HistoryStatus
  processingType ProcessingType
  inputFileName  String?
  inputSize      BigInt?
  inputMime      String?
  outputFileName String?
  outputSize     BigInt?
  creditsCost    Int?
  jobId          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  csrfHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Plan {
  id                String   @id @default(uuid()) @db.Uuid
  code              PlanCode @unique
  monthlyCredits    Int
  maxUploadSize     Int
  maxConcurrentJobs Int
  priority          Int      @default(0)
  historyRetention  Int?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  users UserPlan[]
  orders PaymentOrder[]
}

model UserPlan {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  planId      String   @db.Uuid
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  nextResetAt DateTime?
  active      Boolean  @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
  @@index([userId, active])
}

model CreditLedger {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  amount         Int
  type           LedgerType
  reason         String
  toolId         String?
  jobId          String?
  paymentId      String?    @db.Uuid
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])
  @@index([userId, createdAt])
  @@index([jobId])
}

model ProcessingUsage {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  jobId             String      @unique
  toolId            String
  estimatedCredits  Int
  reservedCredits   Int
  consumedCredits   Int         @default(0)
  inputBytes        BigInt
  status            UsageStatus
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentOrder {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  planId         String?            @db.Uuid
  credits        Int
  amountMinor    Int
  currency       String             @default("PEN")
  status         PaymentOrderStatus @default(PENDING_PAYMENT)
  reference      String?
  idempotencyKey String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id])
  payment Payment?
  @@unique([userId, idempotencyKey])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @unique @db.Uuid
  status      PaymentStatus
  reviewedBy  String        @db.Uuid
  reviewReason String
  createdAt   DateTime      @default(now())
  order PaymentOrder @relation(fields: [orderId], references: [id])
  reviewer User @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  ledger CreditLedger[]
}

model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  adminId      String   @db.Uuid
  targetUserId String?  @db.Uuid
  action       String
  reason       String
  metadata     Json?
  createdAt    DateTime @default(now())
  admin User @relation("AdminActions", fields: [adminId], references: [id])
  targetUser User? @relation("AuditTargets", fields: [targetUserId], references: [id])
  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
}
