generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  ANONYMIZED
}
enum ComplaintType {
  RECLAMO
  QUEJA
}
enum ComplaintStatus {
  RECEIVED
  IN_REVIEW
  RESPONDED
  CLOSED
}
enum SuggestionCategory {
  MEJORA
  NUEVA_FUNCION
  PROBLEMA_UX
  OTRO
}
enum SuggestionStatus {
  SUBMITTED
  REVIEWING
  PLANNED
  DECLINED
  COMPLETED
}
enum UsageStatus {
  RESERVED
  COMPLETED
  FAILED
  CANCELLED
  ADMIN_TEST
}
enum HistoryStatus {
  COMPLETED
  FAILED
  CANCELLED
}
enum ProcessingType {
  LOCAL
  SERVER
  EXTERNAL
}

enum YouTubeCircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

enum ShortLinkStatus {
  ACTIVE
  DISABLED
}

enum ShortLinkReportCategory {
  PHISHING
  MALWARE
  FRAUD
  SPAM
  IMPERSONATION
  ILLEGAL_CONTENT
  OTHER
}

enum ShortLinkReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum ServiceStatusState {
  OPERATIONAL
  LIMITED
  MAINTENANCE
  UNAVAILABLE
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  displayName  String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions Session[]
  usages ProcessingUsage[]
  auditActions AdminAuditLog[] @relation("AdminActions")
  auditTargets AdminAuditLog[] @relation("AuditTargets")
  history ProcessingHistory[]
  complaints Complaint[]
  suggestions Suggestion[]
  shortLinks ShortLink[]
  shortLinkReports ShortLinkReport[]
}

model ShortLink {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  targetUrl   String
  userId      String?  @db.Uuid
  clicks      Int      @default(0)
  status      ShortLinkStatus @default(ACTIVE)
  disabledAt DateTime?
  disabledReason String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  reports ShortLinkReport[]
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([status, createdAt])
}

model ShortLinkReport {
  id          String                  @id @default(uuid()) @db.Uuid
  shortLinkId String                  @db.Uuid
  reporterId  String?                 @db.Uuid
  category    ShortLinkReportCategory
  detail      String?
  status      ShortLinkReportStatus   @default(PENDING)
  reviewedBy  String?                 @db.Uuid
  reviewedAt  DateTime?
  createdAt   DateTime                @default(now())
  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  reporter User? @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  @@index([shortLinkId, status])
  @@index([status, createdAt])
}

model DeniedIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  emailHash String   @unique
  reason    String
  createdAt DateTime @default(now())
  adminId   String   @db.Uuid
  @@index([createdAt])
}

model Complaint {
  id           String          @id @default(uuid()) @db.Uuid
  sequenceNumber Int           @unique @default(autoincrement())
  trackingCode String          @unique
  userId       String?         @db.Uuid
  claimantName String
  documentId   String
  phone        String
  representativeName String?
  representativeDocument String?
  email        String
  type         ComplaintType
  subject      String
  detail       String
  serviceDescription String
  amountMinor  Int?
  consumerRequest String
  status       ComplaintStatus @default(RECEIVED)
  flagged      Boolean         @default(false)
  adminResponse String?
  respondedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Suggestion {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  category      SuggestionCategory
  title         String
  description   String
  status        SuggestionStatus   @default(SUBMITTED)
  adminResponse String?
  reaction      String?
  respondedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ProcessingHistory {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  toolId         String
  status         HistoryStatus
  processingType ProcessingType
  inputFileName  String?
  inputSize      BigInt?
  inputMime      String?
  outputFileName String?
  outputSize     BigInt?
  jobId          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  csrfHash  String
  csrfToken String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model ProcessingUsage {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  jobId             String      @unique
  toolId            String
  inputBytes        BigInt
  status            UsageStatus
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderCircuitBreaker {
  provider                     String              @id
  state                        YouTubeCircuitState @default(CLOSED)
  version                      BigInt              @default(0)
  nextOperationSequence        BigInt              @default(0)
  lastAppliedOperationSequence BigInt              @default(0)
  lastSuccessOperationSequence BigInt              @default(0)
  consecutiveRestrictions      Int                 @default(0)
  restrictionWindowStartedAt   DateTime?
  openedAt                     DateTime?
  cooldownUntil                DateTime?
  cooldownLevel                Int                 @default(0)
  probeToken                   String?             @db.Uuid
  probeLeaseUntil              DateTime?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
}

// Single current product operational status. `singleton` is a unique sentinel
// column: normal application code only ever upserts the fixed "current" key, so
// the unique constraint makes it impossible for the app to persist more than one
// active row. No row is seeded; an empty table means "no explicit admin state".
model ServiceStatus {
  id          String             @id @default(uuid()) @db.Uuid
  singleton   String             @unique @default("current")
  state       ServiceStatusState
  message     String?
  updatedAt   DateTime           @updatedAt
  updatedById String?            @db.Uuid
}

model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  adminId      String   @db.Uuid
  targetUserId String?  @db.Uuid
  action       String
  reason       String
  metadata     Json?
  createdAt    DateTime @default(now())
  admin User @relation("AdminActions", fields: [adminId], references: [id])
  targetUser User? @relation("AuditTargets", fields: [targetUserId], references: [id])
  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
}
