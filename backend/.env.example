# VELYXORA Backend Environment Configuration

NODE_ENV=development

PORT=3000

CORS_ORIGIN=http://localhost:5173
SESSION_COOKIE_SAME_SITE=lax
TRUST_PROXY=false

MAX_UPLOAD_SIZE_MB=100

STORAGE_DIR=storage
TEMP_DIR=temp
TEMP_FILE_TTL_MINUTES=30

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_MS=600000

LIBREOFFICE_PATH=soffice
LIBREOFFICE_TIMEOUT_MS=600000

YT_DLP_PATH=yt-dlp
YT_DLP_TIMEOUT_MS=600000

# OPTIONAL MEDIA / YOUTUBE INTEGRATION
# Internal bgutil PO-token provider used only for YouTube server processing.
# Must be an http:// loopback or private hostname (no dots, or *.internal);
# any other value is rejected as unsafe. Leave empty to disable YouTube
# server-side processing (it reports MEDIA_PROVIDER_RESTRICTED instead).
# Example used by compose.youtube-staging.yml: http://youtube-pot-provider:4416
YOUTUBE_PO_TOKEN_PROVIDER_URL=
# Troubleshooting only; leave disabled in normal/production use.
# YOUTUBE_DIAGNOSTICS_ENABLED=true  # verbose yt-dlp YouTube traces
# MEDIA_STAGING_DIAGNOSTICS=true    # verbose TikTok analyze traces (staging)

DATABASE_URL=postgresql://velyxora:change-me@localhost:5432/velyxora?schema=public
# Keep this value stable: changing it invalidates every existing password hash.
AUTH_PASSWORD_PEPPER=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password
# OPTIONAL PUBLIC COMPLAINT BOOK PROVIDER DETAILS
COMPLAINT_PROVIDER_NAME=VELYXORA / WangLing Tech
COMPLAINT_PROVIDER_RUC=
COMPLAINT_PROVIDER_ADDRESS=
