# Dependencies
node_modules/

# Builds
build/
dist/
coverage/
frontend/dist/
backend/dist/

# Environment files / secrets
.env
.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

# Logs and temporary reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lint-*.txt
*-lint.txt

# Temporary files
*.tmp
*.temp

# Runtime temporary/storage folders
backend/temp/*
backend/storage/*
temp/*
storage/*

# Keep empty runtime directories
!backend/temp/.gitkeep
!backend/storage/.gitkeep

# Generated artifacts
artifacts/

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/

# Local AI / coding-assistant tooling (owner-local, not part of the project)
.agents/
AGENTS.md
opencode.json
docs/modelsopencode.md

# Caches and incremental build metadata
.cache/
.vite/
.turbo/
*.tsbuildinfo

