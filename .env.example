
# VELYXORA template. Copy only the relevant section; never commit .env.
# LOCAL DEVELOPMENT
NODE_ENV=development
PORT=3000
VITE_API_URL=http://localhost:3000/api
CORS_ORIGIN=http://localhost:5173
# En producción el valor por defecto es none (beta Vercel/Railway cross-site).
# Use lax cuando frontend y API compartan el sitio velyxora.com.
SESSION_COOKIE_SAME_SITE=lax
DATABASE_URL=postgresql://velyxora:change-me@localhost:5432/velyxora?schema=public
TRUST_PROXY=false
STORAGE_DIR=backend/storage
TEMP_DIR=backend/temp

# PRODUCTION (configure in Railway/Vercel; values shown as documentation)
# Railway injects PORT and DATABASE_URL.
# NODE_ENV=production
# VITE_API_URL=https://api.velyxora.com/api  # Vercel only
# CORS_ORIGIN=https://velyxora.com
# SESSION_COOKIE_SAME_SITE=lax
# TRUST_PROXY=true
# STORAGE_DIR=/tmp/velyxora/results
# TEMP_DIR=/tmp/velyxora/uploads

# BACKEND LIMITS / ENGINES
MAX_UPLOAD_SIZE_MB=100
# Solo ADMIN fuera de producción. Default: 1024; rango válido: 1-16384 MiB.
# Railway no necesita configurar esta variable.
LOCAL_ADMIN_MAX_UPLOAD_SIZE_MB=1024
TEMP_FILE_TTL_MINUTES=30
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_MS=600000
LIBREOFFICE_PATH=soffice
LIBREOFFICE_TIMEOUT_MS=600000
YT_DLP_PATH=yt-dlp
YT_DLP_TIMEOUT_MS=600000

# OPTIONAL MEDIA / YOUTUBE INTEGRATION
# Internal bgutil PO-token provider used only for YouTube server processing.
# Must be an http:// loopback or private hostname (no dots, or *.internal);
# any other value is rejected as unsafe. Leave empty to disable YouTube
# server-side processing (it reports MEDIA_PROVIDER_RESTRICTED instead).
# Example used by compose.youtube-staging.yml: http://youtube-pot-provider:4416
YOUTUBE_PO_TOKEN_PROVIDER_URL=
# Troubleshooting only; leave disabled in normal/production use.
# YOUTUBE_DIAGNOSTICS_ENABLED=true  # verbose yt-dlp YouTube traces
# MEDIA_STAGING_DIAGNOSTICS=true    # verbose TikTok analyze traces (staging)

# REQUIRED PRODUCTION SECRET. Keep stable; changing it invalidates password hashes.
AUTH_PASSWORD_PEPPER=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168

# OPTIONAL CONTROLLED SEED. Remove the password after the first successful seed.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Opt-in de una sola ejecución: permite que el seed rote explícitamente el hash
# de un usuario existente cuando INITIAL_ADMIN_PASSWORD no coincide.
INITIAL_ADMIN_UPDATE_EXISTING_PASSWORD=false

# OPTIONAL PUBLIC COMPLAINT BOOK PROVIDER DETAILS
COMPLAINT_PROVIDER_NAME=VELYXORA
COMPLAINT_PROVIDER_RUC=
COMPLAINT_PROVIDER_ADDRESS=
