
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VELYXORA Backend API URL (Optional when connecting external microservices in VS Code)
VITE_API_URL="http://localhost:3000/api"
YT_DLP_PATH="yt-dlp"
YT_DLP_TIMEOUT_MS="600000"
DATABASE_URL=postgresql://velyxora:change-me@localhost:5432/velyxora?schema=public
AUTH_PASSWORD_PEPPER=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
BETA_MANUAL_PAYMENTS=true
YAPE_DISPLAY_NAME=VELYXORA Beta
YAPE_PHONE=configure-on-server
